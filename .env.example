# Required: Anthropic API key for Claude virality scoring
ANTHROPIC_API_KEY=sk-ant-...

# Whisper model size (large-v3 requires ~10GB VRAM, use "medium" or "small" for CPU)
WHISPER_MODEL=large-v3

# Output directory for downloaded videos and rendered clips
OUTPUT_DIR=./output

# Service URLs (defaults if not set)
ML_PROCESSOR_URL=http://localhost:8000
RENDER_SERVER_URL=http://localhost:3001
